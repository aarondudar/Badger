# Copy to .env for local development: cp .env.example .env
# Never commit .env. docker compose reads it for the emulator, api, and worker.

AWS_REGION=us-east-1
# Local AWS emulator (Floci, LocalStack-compatible). Set locally only; leave unset on real AWS.
AWS_ENDPOINT_URL=http://localstack:4566
# Dummy values accepted by the emulator. Not real credentials; never put real ones here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS job queue. infra/localstack/init.sh creates the queue named by the last path segment.
QUEUE_URL=http://localstack:4566/000000000000/scan-jobs
# DynamoDB table for scan records
TABLE_NAME=scans
# S3 bucket for full reports
BUCKET_NAME=scan-reports

# API port
PORT=3000
# Abort clones that take longer than this
CLONE_TIMEOUT_MS=60000
# Reject repos larger than this
MAX_REPO_MB=100
