# Copy to .env for local development. Never commit .env.
AWS_REGION=us-east-1
# Set locally only; leave unset on real AWS
AWS_ENDPOINT_URL=http://localstack:4566
# Dummy values for LocalStack only
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_URL=http://localstack:4566/000000000000/scan-jobs
TABLE_NAME=scans
BUCKET_NAME=scan-reports
PORT=3000
CLONE_TIMEOUT_MS=60000
MAX_REPO_MB=100
