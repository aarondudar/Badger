{
    "name": "badger",
    "private": true,
    "description": "Root shortcuts: forwards to sast/backend and docker compose",
    "scripts": {
        "setup": "npm --prefix sast/backend ci",
        "start": "npm --prefix sast/backend start",
        "dev": "npm --prefix sast/backend run dev",
        "test": "npm --prefix sast/backend test",
        "worker": "npm --prefix sast/backend run worker",
        "smoke": "docker compose run --rm api npm run smoke",
        "up": "docker compose up --build",
        "down": "docker compose down"
    }
}